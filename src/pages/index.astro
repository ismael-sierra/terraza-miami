---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import OpeningHours from "../components/OpeningHours.astro";
import { negocio } from "../data/negocio";
import { destacados, formatearPrecio } from "../data/carta";

const galeria = [
  { src: "/images/terraza-miami_01.jpeg", alt: "Terraza Miami en Puebla del Prior" },
  { src: "/images/terraza-miami_02.jpeg", alt: "Terraza Miami en Puebla del Prior" },
  { src: "/images/terraza-miami_03.jpeg", alt: "Terraza Miami en Puebla del Prior" },
  { src: "/images/terraza-miami_04.jpeg", alt: "Ambiente de Terraza Miami" },
  { src: "/images/terraza-miami_05.jpeg", alt: "Clientes disfrutando de Terraza Miami" },
  { src: "/images/terraza-miami_06.jpeg", alt: "Equipo de Terraza Miami" },
];
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    name: "Terraza Miami",
    telephone: "+34675326150",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Carretera Hornachos - Villafranca de los Barros",
      postalCode: "06229",
      addressLocality: "Puebla del Prior",
      addressRegion: "Badajoz",
      addressCountry: "ES",
    },
    servesCuisine: ["Tapas", "Comida española"],
    sameAs: ["https://www.facebook.com/profile.php?id=61591632389910"],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "12:00",
        closes: "16:00",
      },
    ],
  })}
/>

<BaseLayout
  title="Terraza Miami | Bar en Puebla del Prior"
  description="Terraza Miami en Puebla del Prior, Badajoz. Tapas, raciones, comidas, cenas, cafés y copas para disfrutar en nuestra terraza."
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero">
      <img class="hero-background" src="/images/cabecera.jpg" alt="" />

      <div class="hero-overlay"></div>

      <div class="container hero-content">
        <img class="hero-logo" src="/images/logo.jpg" alt="Terraza Miami" />

        <p class="eyebrow">Puebla del Prior · Badajoz</p>

        <h1>Un lugar para disfrutar</h1>

        <p class="hero-text">
          Tapas, raciones, comidas, cenas, cafés y copas para compartir buenos
          momentos en nuestra terraza.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href={negocio.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>

          <a class="button button-secondary" href={negocio.telefono.enlace}>
            Llamar
          </a>
        </div>
      </div>
    </section>

    <!-- QUÉ OFRECEMOS -->

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h2>Para cualquier momento del día</h2>

          <p>
            Un espacio para venir a tomar algo, comer, cenar o simplemente
            disfrutar de la tarde.
          </p>
        </div>

        <div class="features">
          <article class="feature">
            <h3>Tapas y raciones</h3>

            <p>Para compartir y disfrutar sin prisas.</p>
          </article>

          <article class="feature">
            <h3>Comidas y cenas</h3>

            <p>
              Opciones para disfrutar de una comida o una cena en buena
              compañía.
            </p>
          </article>

          <article class="feature">
            <h3>Cafés y copas</h3>

            <p>Un café por la tarde o una copa para terminar el día.</p>
          </article>

          <article class="feature">
            <h3>Nuestra terraza</h3>

            <p>
              Un espacio al aire libre junto al parque, con buena música y buen
              ambiente.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ENTORNO -->

    <section class="section section-dark">
      <div class="container two-columns">
        <div>
          <p class="eyebrow">Nuestro entorno</p>

          <h2>Terraza, parque y buena compañía</h2>

          <p>
            Terraza Miami está situada junto al parque de Puebla del Prior, un
            entorno perfecto para disfrutar de una tarde tranquila o compartir
            un buen rato con amigos.
          </p>

          <p>Buena gente, buena música y un ambiente pensado para disfrutar.</p>
        </div>

        <div class="highlight-box">
          <p class="highlight-text">Buenos momentos, sin complicaciones.</p>
        </div>
      </div>
    </section>

    <!-- GALERÍA -->
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Conócenos</p>
          <h2>Así es Terraza Miami</h2>
          <p>
            Un espacio para disfrutar de la terraza, la comida y el buen
            ambiente.
          </p>
        </div>

        <Gallery imagenes={galeria} />
      </div>
    </section>

    <!-- CARTA -->

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Para comer</p>

          <h2>Descubre nuestra carta</h2>

          <p>
            Consulta nuestra carta para descubrir todo lo que tenemos para
            ofrecerte.
          </p>
        </div>

        <div class="menu-preview">
          {
            destacados.map((plato) => (
              <article class="menu-preview-item">
                <div>
                  <h3>{plato.nombre}</h3>

                  {plato.descripcion && <p>{plato.descripcion}</p>}
                </div>

                <strong>{formatearPrecio(plato.precio)}</strong>
              </article>
            ))
          }
        </div>

        <div class="section-action">
          <a class="button" href="/carta"> Ver carta completa </a>
        </div>
      </div>
    </section>

    <!-- RESEÑAS -->

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Nuestros clientes</p>

          <h2>Lo que dicen de nosotros</h2>

          <p>
            Terraza Miami cuenta con opiniones de clientes que han disfrutado
            del bar, la terraza y su ambiente.
          </p>
        </div>

        <div class="reviews-summary">
          <div class="reviews-score">
            <strong>{negocio.valoracion.nota}</strong>

            <div
              class="reviews-stars"
              role="img"
              aria-label={`Valoración de ${negocio.valoracion.nota} sobre 5`}
            >
              ★★★★★
            </div>

            <p>{negocio.valoracion.opiniones} opiniones en Google</p>
          </div>

          <div class="reviews-info">
            <h3>¿Ya nos has visitado?</h3>

            <p>
              Tu opinión nos ayuda a seguir mejorando y también puede ayudar a
              otras personas a conocernos.
            </p>

            <a
              class="button"
              href={negocio.mapas.resenas}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver opiniones en Google
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- HORARIO -->

    <section class="section section-dark">
      <div class="container contact-section">
        <div>
          <p class="eyebrow">Ven a visitarnos</p>

          <h2>Estamos en Puebla del Prior</h2>

          <p>
            {negocio.direccion.calle}<br />
            {negocio.direccion.codigoPostal} {negocio.direccion.localidad},
            {negocio.direccion.provincia}
          </p>

          <p>
            <a href={negocio.telefono.enlace}>{negocio.telefono.visible}</a>
          </p>
        </div>

        <div>
          <h3>Horario</h3>

          <OpeningHours />
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->

    <section class="section final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>¿Nos vemos?</h2>

        <p>Llámanos o escríbenos por WhatsApp.</p>

        <div class="hero-actions">
          <a
            class="button"
            href={negocio.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribir por WhatsApp
          </a>

          <a class="button button-secondary" href="/contacto"> Cómo llegar </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
