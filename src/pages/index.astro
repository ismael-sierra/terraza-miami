---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    name: "Terraza Miami",
    telephone: "+34675326150",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Cam. Puebla del Prior",
      postalCode: "06229",
      addressLocality: "Puebla del Prior",
      addressRegion: "Badajoz",
      addressCountry: "ES",
    },
    servesCuisine: ["Tapas", "Comida española"],
    sameAs: ["https://www.facebook.com/profile.php?id=61591632389910"],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "12:00",
        closes: "16:00",
      },
    ],
  })}
/>

<BaseLayout
  title="Terraza Miami | Bar en Puebla del Prior"
  description="Terraza Miami en Puebla del Prior, Badajoz. Tapas, raciones, comidas, cenas, cafés y copas para disfrutar en nuestra terraza."
>
  <Header />

  <main>
    <!-- HERO -->

    <section class="hero">
      <div class="container">
        <img class="hero-logo" src="/images/logo.jpg" alt="Terraza Miami" />

        <p class="eyebrow">Puebla del Prior · Badajoz</p>

        <h1>Un lugar para disfrutar</h1>

        <p class="hero-text">
          Tapas, raciones, comidas, cenas, cafés y copas para compartir buenos
          momentos en nuestra terraza.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href="https://wa.me/34675326150"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>

          <a class="button button-secondary" href="tel:+34675326150">
            Llamar
          </a>
        </div>
      </div>
    </section>

    <!-- QUÉ OFRECEMOS -->

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h2>Para cualquier momento del día</h2>

          <p>
            Un espacio para venir a tomar algo, comer, cenar o simplemente
            disfrutar de la tarde.
          </p>
        </div>

        <div class="features">
          <article class="feature">
            <h3>Tapas y raciones</h3>

            <p>Para compartir y disfrutar sin prisas.</p>
          </article>

          <article class="feature">
            <h3>Comidas y cenas</h3>

            <p>
              Opciones para disfrutar de una comida o una cena en buena
              compañía.
            </p>
          </article>

          <article class="feature">
            <h3>Cafés y copas</h3>

            <p>Un café por la tarde o una copa para terminar el día.</p>
          </article>

          <article class="feature">
            <h3>Nuestra terraza</h3>

            <p>
              Un espacio al aire libre junto al parque, con buena música y buen
              ambiente.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ENTORNO -->

    <section class="section section-dark">
      <div class="container two-columns">
        <div>
          <p class="eyebrow">Nuestro entorno</p>

          <h2>Terraza, parque y buena compañía</h2>

          <p>
            Terraza Miami está situada junto al parque de Puebla del Prior, un
            entorno perfecto para disfrutar de una tarde tranquila o compartir
            un buen rato con amigos.
          </p>

          <p>Buena gente, buena música y un ambiente pensado para disfrutar.</p>
        </div>

        <div class="highlight-box">
          <p class="highlight-text">Buenos momentos, sin complicaciones.</p>
        </div>
      </div>
    </section>

    <!-- CARTA -->

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Para comer</p>

          <h2>Algunos de nuestros platos</h2>

          <p>
            Consulta nuestra carta para descubrir todo lo que tenemos para
            ofrecerte.
          </p>
        </div>

        <div class="menu-preview">
          <article class="menu-preview-item">
            <div>
              <h3>Montados de lomo</h3>
            </div>

            <strong> 2 € </strong>
          </article>

          <article class="menu-preview-item">
            <div>
              <h3>Rejos</h3>
            </div>

            <strong> 10 € </strong>
          </article>

          <article class="menu-preview-item">
            <div>
              <h3>Calamares</h3>
            </div>

            <strong> 10 € </strong>
          </article>

          <article class="menu-preview-item">
            <div>
              <h3>Bocadillos</h3>

              <p>Lomo, bacon o pollo.</p>
            </div>

            <strong> 5 € </strong>
          </article>

          <article class="menu-preview-item">
            <div>
              <h3>Hamburguesas</h3>
            </div>

            <strong> 4 € </strong>
          </article>
        </div>

        <div class="section-action">
          <a class="button" href="/carta"> Ver carta completa </a>
        </div>
      </div>
    </section>

    <!-- HORARIO -->

    <section class="section section-dark">
      <div class="container contact-section">
        <div>
          <p class="eyebrow">Ven a visitarnos</p>

          <h2>Estamos en Puebla del Prior</h2>

          <p>
            Cam. Puebla del Prior<br />
            06229 Puebla del Prior, Badajoz
          </p>

          <p>
            <a href="tel:+34675326150"> 675 326 150 </a>
          </p>
        </div>

        <div>
          <h3>Horario</h3>

          <div class="opening-hours">
            <p>
              <strong>Lunes</strong>
              <span>12:00–16:00 · 20:00–01:00</span>
            </p>

            <p>
              <strong>Martes</strong>
              <span>Cerrado</span>
            </p>

            <p>
              <strong>Miércoles</strong>
              <span>12:00–16:00 · 20:00–01:00</span>
            </p>

            <p>
              <strong>Jueves</strong>
              <span>12:00–16:00 · 20:00–01:00</span>
            </p>

            <p>
              <strong>Viernes</strong>
              <span>12:00–16:00 · 20:00–02:00</span>
            </p>

            <p>
              <strong>Sábado</strong>
              <span>12:00–16:00 · 20:00–02:00</span>
            </p>

            <p>
              <strong>Domingo</strong>
              <span>12:00–16:00 · 20:00–01:00</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->

    <section class="section final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>¿Nos vemos?</h2>

        <p>Llámanos o escríbenos por WhatsApp.</p>

        <div class="hero-actions">
          <a
            class="button"
            href="https://wa.me/34675326150"
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribir por WhatsApp
          </a>

          <a class="button button-secondary" href="/contacto"> Cómo llegar </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
