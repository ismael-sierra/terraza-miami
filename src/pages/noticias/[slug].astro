---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";
import { negocio } from "../../data/negocio";
import { fechaVisible, getNoticiasOrdenadas } from "../../utils/noticias";

export async function getStaticPaths() {
  const noticias = await getNoticiasOrdenadas();

  return noticias.map((noticia) => ({
    params: { slug: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { data } = noticia;
const { Content } = await render(noticia);

const evento = data.evento;
const fechaEvento = evento?.fecha.toISOString().slice(0, 10);

// Datos estructurados para que Google pueda mostrar el evento en los resultados.
const eventoJsonLd = evento && {
  "@context": "https://schema.org",
  "@type": "Event",
  name: data.titulo,
  description: data.descripcion,
  startDate: fechaEvento,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  image: data.imagen && new URL(data.imagen.src, Astro.site).href,
  location: {
    "@type": "Place",
    name: negocio.nombre,
    address: {
      "@type": "PostalAddress",
      streetAddress: negocio.direccion.calle,
      postalCode: negocio.direccion.codigoPostal,
      addressLocality: negocio.direccion.localidad,
      addressRegion: negocio.direccion.provincia,
      addressCountry: "ES",
    },
  },
  organizer: {
    "@type": "Organization",
    name: negocio.nombre,
    url: Astro.site?.href,
  },
};
---

<BaseLayout
  title={data.tituloSeo ?? `${data.titulo} | ${negocio.nombre}`}
  description={data.descripcion}
  ogImage={data.imagen?.src}
>
  {
    eventoJsonLd && (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(eventoJsonLd)}
      />
    )
  }

  <Header />

  <main>
    <article class="section news-detail">
      <div class="container">
        <p class="eyebrow">{data.etiqueta}</p>

        <h1>{data.titulo}</h1>

        <p class="intro">{data.descripcion}</p>

        <p class="news-detail-date">
          <strong>{fechaVisible(noticia)}</strong>
        </p>

        {
          evento && (
            <p class="event-finished" data-fecha-evento={fechaEvento} hidden>
              Este evento ya se celebró. ¡Gracias a todos los que vinisteis!
            </p>
          )
        }

        {
          data.imagen && !data.galeria && (
            <div class="news-detail-image">
              <img src={data.imagen.src} alt={data.imagen.alt} />
            </div>
          )
        }

        {
          evento && (
            <div class="event-details">
              {evento.detalles.map(({ etiqueta, valor }) => (
                <div class="event-detail">
                  <span class="event-detail-label">{etiqueta}</span>
                  <strong>{valor}</strong>
                </div>
              ))}
            </div>
          )
        }

        <div class="news-detail-content">
          <Content />

          {
            evento && (
              <div class="event-highlights">
                {evento.destacados.map(({ icono, titulo, texto }) => (
                  <div>
                    <span aria-hidden="true">{icono}</span>
                    <strong>{titulo}</strong>
                    <p>{texto}</p>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        {
          data.galeria && (
            <div class="news-detail-gallery">
              <Gallery imagenes={data.galeria} />
            </div>
          )
        }

        <div class="news-detail-cta">
          <p class="eyebrow">{negocio.nombre}</p>

          <h2>¿Nos vemos en Puebla del Prior?</h2>

          <p>
            Ven a disfrutar de tapas, raciones, comidas, cenas, cafés y copas.
          </p>

          <div class="hero-actions">
            <a class="button" href="/contacto">Contacto</a>

            <a
              class="button button-secondary"
              href={negocio.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
          </div>
        </div>

        <div class="news-detail-back">
          <a class="news-link" href="/noticias">← Volver a noticias</a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  // La web es estática, así que se comprueba en el navegador si el evento ya
  // pasó. Se da por terminado a las 7:00 del día siguiente (hora peninsular).
  const aviso = document.querySelector<HTMLElement>("[data-fecha-evento]");
  const fecha = aviso?.dataset.fechaEvento;

  if (aviso && fecha) {
    const fin = new Date(`${fecha}T07:00:00+02:00`);
    fin.setDate(fin.getDate() + 1);

    if (Date.now() > fin.valueOf()) aviso.hidden = false;
  }
</script>
