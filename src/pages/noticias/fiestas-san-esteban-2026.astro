---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
  title="Primer San Esteban de Terraza Miami | Puebla del Prior 2026"
  description="Terraza Miami vive su primer San Esteban en Puebla del Prior. Descubre algunos de los momentos de nuestras primeras fiestas junto al pueblo."
>
  <Header />

  <main>
    <article>
      <!-- CABECERA -->
      <section class="section">
        <div class="container">
          <p class="eyebrow">Noticias · Puebla del Prior</p>

          <h1>Primer San Esteban de Terraza Miami en Puebla del Prior</h1>

          <p class="intro">
            Este verano hemos vivido nuestro primer San Esteban en Terraza
            Miami. Unas fiestas muy especiales que han llenado Puebla del Prior
            de ambiente, encuentros y buenos momentos.
          </p>

          <p class="news-date">Actualizado en 2026</p>
        </div>
      </section>

      <!-- NUESTRO PRIMER SAN ESTEBAN -->
      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Nuestro primer San Esteban</p>

            <h2>Un verano muy especial para Terraza Miami</h2>

            <p class="intro">
              Terraza Miami abrió sus puertas este verano, y las fiestas de San
              Esteban de 2026 han sido las primeras que hemos podido compartir
              con nuestros clientes, vecinos y amigos.
            </p>
          </div>

          <!-- GALERÍA SAN ESTEBAN -->
          <div class="gallery">
            <button
              class="gallery-item"
              type="button"
              data-lightbox="/images/terraza-miami_04.jpeg"
              aria-label="Ver imagen de San Esteban 2026"
            >
              <img
                src="/images/terraza-miami_04.jpeg"
                alt="San Esteban 2026 en Terraza Miami"
                loading="lazy"
              />
            </button>

            <button
              class="gallery-item"
              type="button"
              data-lightbox="/images/terraza-miami_05.jpeg"
              aria-label="Ver imagen de San Esteban 2026"
            >
              <img
                src="/images/terraza-miami_05.jpeg"
                alt="Ambiente de San Esteban 2026 en Terraza Miami"
                loading="lazy"
              />
            </button>

            <button
              class="gallery-item"
              type="button"
              data-lightbox="/images/terraza-miami_06.jpeg"
              aria-label="Ver imagen de San Esteban 2026"
            >
              <img
                src="/images/terraza-miami_06.jpeg"
                alt="Terraza Miami durante las fiestas de San Esteban 2026"
                loading="lazy"
              />
            </button>
          </div>
        </div>
      </section>

      <!-- HISTORIA -->
      <section class="section">
        <div class="container">
          <div class="two-columns">
            <div>
              <p class="eyebrow">Puebla del Prior</p>

              <h2>Una primera fiesta para recordar</h2>

              <p>
                La apertura de Terraza Miami este verano ha coincidido con una
                de las épocas más especiales del año en Puebla del Prior.
              </p>

              <p>
                Por eso, vivir nuestro primer San Esteban ha sido una
                experiencia especialmente importante para nosotros. Hemos podido
                disfrutar de estas fiestas junto a las personas que han decidido
                acercarse a Terraza Miami durante estos primeros meses.
              </p>

              <p>
                Queremos agradecer a todos los que habéis formado parte de estos
                primeros momentos y habéis ayudado a convertir este primer San
                Esteban en un recuerdo especial.
              </p>
            </div>

            <div class="highlight-box">
              <p class="highlight-text">
                Primer<br />
                San Esteban<br />
                2026
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- TERRAZA MIAMI -->
      <section class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Terraza Miami</p>

            <h2>Un lugar para seguir disfrutando</h2>

            <p class="intro">
              Las fiestas pasan, pero las ganas de disfrutar de Puebla del Prior
              continúan durante todo el año.
            </p>
          </div>

          <div class="news-grid">
            <article class="news-card">
              <div class="news-card-content">
                <h3>Tapas y raciones</h3>

                <p>
                  Disfruta de nuestra carta y comparte unas tapas o raciones en
                  Terraza Miami.
                </p>

                <a class="news-link" href="/carta"> Ver nuestra carta → </a>
              </div>
            </article>

            <article class="news-card">
              <div class="news-card-content">
                <h3>Terraza y copas</h3>

                <p>
                  Un café por la tarde, una copa o simplemente un rato agradable
                  con amigos en nuestra terraza.
                </p>

                <a class="news-link" href="/contacto"> Cómo llegar → </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- AGRADECIMIENTO -->
      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Gracias</p>

            <h2>Gracias por acompañarnos</h2>

            <p class="intro">
              Este ha sido nuestro primer San Esteban, pero esperamos que sean
              muchos más los que podamos compartir con vosotros.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="section final-cta section-dark">
        <div class="container">
          <p class="eyebrow">Terraza Miami</p>

          <h2>¿Nos vemos en Puebla del Prior?</h2>

          <p>
            Ven a disfrutar de tapas, raciones, comidas, cenas, cafés y copas.
          </p>

          <div class="hero-actions">
            <a class="button" href="/contacto"> Contacto </a>

            <a
              class="button button-secondary"
              href="https://wa.me/34675326150"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />

  <!-- LIGHTBOX -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar imagen">
      ×
    </button>

    <img class="lightbox-image" src="" alt="" />
  </div>

  <!-- LIGHTBOX SCRIPT -->
  <script>
    const lightbox = document.querySelector("#lightbox");
    const lightboxImage = document.querySelector(".lightbox-image");
    const closeButton = document.querySelector(".lightbox-close");
    const galleryItems = document.querySelectorAll("[data-lightbox]");

    function openLightbox(src: string, alt: string) {
      if (!lightbox || !lightboxImage) return;

      lightboxImage.setAttribute("src", src);
      lightboxImage.setAttribute("alt", alt || "Imagen de Terraza Miami");

      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");

      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImage) return;

      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");

      document.body.style.overflow = "";

      setTimeout(() => {
        lightboxImage.setAttribute("src", "");
      }, 200);
    }

    galleryItems.forEach((item) => {
      item.addEventListener("click", () => {
        const src = item.getAttribute("data-lightbox");
        const image = item.querySelector("img");

        if (src) {
          openLightbox(src, image?.getAttribute("alt") || "");
        }
      });
    });

    closeButton?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeLightbox();
      }
    });
  </script>
</BaseLayout>
