---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
  title="Noticias | Terraza Miami"
  description="Noticias, eventos y novedades de Terraza Miami en Puebla del Prior."
>
  <Header />

  <main>
    <!-- CABECERA -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h1>Noticias y novedades</h1>

        <p class="intro">
          Descubre nuestras novedades, eventos y actividades en Puebla del
          Prior.
        </p>
      </div>
    </section>

    <!-- NOTICIAS -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Últimas noticias</p>

          <h2>Descubre lo que pasa en Terraza Miami</h2>
        </div>

        <div class="news-grid">
          <!-- NOTICIA 1 -->
          <article class="news-card">
            <div class="news-card-content">
              <p class="news-date">Agosto 2026</p>

              <h3>Nuestro primer San Esteban en Puebla del Prior</h3>

              <p>
                Este verano hemos vivido nuestro primer San Esteban desde la
                apertura de Terraza Miami. Descubre algunos de los momentos que
                compartimos durante estas fiestas.
              </p>

              <a class="news-link" href="/noticias/fiestas-san-esteban-2026">
                Leer noticia →
              </a>
            </div>
          </article>

          <!-- FUTURAS NOTICIAS -->
          <article class="news-card news-card-placeholder">
            <div class="news-card-content">
              <p class="news-date">Próximamente</p>

              <h3>Nuevas noticias</h3>

              <p>
                Aquí iremos publicando nuevas novedades, eventos y contenidos
                relacionados con Terraza Miami y Puebla del Prior.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>¿Nos vemos en la terraza?</h2>

        <p>
          Ven a disfrutar de tapas, raciones, comidas, cenas, cafés y copas en
          Puebla del Prior.
        </p>

        <div class="hero-actions">
          <a class="button" href="/contacto"> Contacto </a>

          <a
            class="button button-secondary"
            href="https://wa.me/34675326150"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
