---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
  title="Noticias | Terraza Miami"
  description="Noticias, eventos y novedades de Terraza Miami en Puebla del Prior."
>
  <Header />

  <main>
    <section class="section">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h1>Noticias y novedades</h1>

        <p class="intro">
          Descubre nuestras novedades, eventos y actividades en Puebla del
          Prior.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
