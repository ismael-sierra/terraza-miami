---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { negocio } from "../../data/negocio";
import { fechaVisible, getNoticiasOrdenadas } from "../../utils/noticias";

const noticias = await getNoticiasOrdenadas();
---

<BaseLayout
  title="Noticias | Terraza Miami"
  description="Noticias, eventos y novedades de Terraza Miami en Puebla del Prior."
>
  <Header />

  <main>
    <!-- CABECERA -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h1>Noticias y novedades</h1>

        <p class="intro">
          Descubre nuestras novedades, eventos y actividades en Puebla del
          Prior.
        </p>
      </div>
    </section>

    <!-- NOTICIAS -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Últimas noticias</p>

          <h2>Descubre lo que pasa en Terraza Miami</h2>
        </div>

        <div class="news-grid">
          {
            noticias.map((noticia) => (
              <article class="news-card">
                {noticia.data.imagen && (
                  <img
                    class="news-card-image"
                    src={noticia.data.imagen.src}
                    alt={noticia.data.imagen.alt}
                    loading="lazy"
                  />
                )}

                <div class="news-card-content">
                  <p class="news-date">{fechaVisible(noticia)}</p>

                  <h3>{noticia.data.titulo}</h3>

                  <p>{noticia.data.descripcion}</p>

                  <a class="news-link" href={`/noticias/${noticia.id}`}>
                    Leer noticia →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>¿Nos vemos en la terraza?</h2>

        <p>
          Ven a disfrutar de tapas, raciones, comidas, cenas, cafés y copas en
          Puebla del Prior.
        </p>

        <div class="hero-actions">
          <a class="button" href="/contacto">Contacto</a>

          <a
            class="button button-secondary"
            href={negocio.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
