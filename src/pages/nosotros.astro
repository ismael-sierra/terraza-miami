---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Sobre nosotros | Terraza Miami"
  description="Conoce Terraza Miami, un espacio para disfrutar de buena comida, terraza y buenos momentos en Puebla del Prior."
>
  <Header />

  <main>
    <!-- INTRO -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h1>Un lugar para disfrutar</h1>

        <p class="intro">
          Terraza Miami es un espacio pensado para disfrutar de la comida, la
          terraza y, sobre todo, de los buenos momentos en Puebla del Prior.
        </p>
      </div>
    </section>

    <!-- QUIÉNES SOMOS -->
    <section class="section section-dark">
      <div class="container two-columns">
        <div>
          <p class="eyebrow">Quiénes somos</p>

          <h2>Detrás de Terraza Miami hay un equipo</h2>

          <p>
            Somos un equipo que trabaja cada día para ofrecer un lugar donde
            puedas venir a comer, tomar algo, disfrutar de una tarde tranquila o
            compartir un rato con amigos.
          </p>

          <p>
            En Terraza Miami nos gusta cuidar el ambiente, la comida y el trato
            cercano para que cada visita sea una buena experiencia.
          </p>
        </div>

        <div>
          <img
            src="/images/terraza-miami_06.jpeg"
            alt="Equipo de Terraza Miami"
            class="about-image"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- QUÉ ENCONTRARÁS -->
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Nuestro espacio</p>

          <h2>Un sitio para cada momento</h2>

          <p>
            Desde un café por la tarde hasta una cena con amigos, queremos que
            Terraza Miami sea un lugar al que apetezca volver.
          </p>
        </div>

        <div class="features">
          <article class="feature">
            <h3>Tapas y raciones</h3>
            <p>Para compartir y disfrutar de la comida sin prisas.</p>
          </article>

          <article class="feature">
            <h3>Comidas y cenas</h3>
            <p>
              Una opción para reunirse alrededor de la mesa y pasar un buen
              rato.
            </p>
          </article>

          <article class="feature">
            <h3>Cafés y copas</h3>
            <p>
              Para empezar la tarde con un café o terminar el día con una copa.
            </p>
          </article>

          <article class="feature">
            <h3>Nuestra terraza</h3>
            <p>
              Un espacio al aire libre para disfrutar del ambiente y de la buena
              compañía.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section class="section section-dark final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>Ven a conocernos</h2>

        <p>
          Estamos en Puebla del Prior. Te esperamos para compartir buenos
          momentos.
        </p>

        <div class="hero-actions">
          <a class="button" href="/carta"> Ver nuestra carta </a>

          <a class="button button-secondary" href="/contacto"> Cómo llegar </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
