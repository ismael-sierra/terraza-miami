---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Reseñas | Terraza Miami"
  description="Consulta las opiniones de los clientes de Terraza Miami en Puebla del Prior y descubre por qué disfrutan de nuestro ambiente y terraza."
>
  <Header />

  <main>
    <!-- CABECERA -->
    <section class="section reviews-page-header">
      <div class="container">
        <p class="eyebrow">Opiniones</p>

        <h1>Lo que dicen nuestros clientes</h1>

        <p class="intro">
          Las opiniones de quienes nos visitan son una parte importante de
          Terraza Miami. Puedes consultar todas las reseñas directamente en
          Google.
        </p>
      </div>
    </section>

    <!-- RESUMEN -->
    <section class="section section-dark">
      <div class="container">
        <div class="reviews-overview">
          <div class="reviews-big-score">
            <strong>4,2</strong>

            <div class="reviews-stars" aria-label="Valoración de 4,2 sobre 5">
              ★★★★★
            </div>

            <p>16 opiniones en Google</p>
          </div>

          <div class="reviews-overview-text">
            <p class="eyebrow">Terraza Miami</p>

            <h2>Gracias por cada opinión</h2>

            <p>
              Cada reseña ayuda a que nuevas personas conozcan nuestro bar y
              también nos permite seguir mejorando día a día.
            </p>

            <a
              class="button"
              href="https://www.google.es/maps/place/Parque+la+hispanidad/@38.5677406,-6.1930035,715m/data=!3m1!1e3!4m8!3m7!1s0xd14092a6baeba51:0x94ac90d5b47e1f7c!8m2!3d38.5694522!4d-6.1939954!9m1!1b1!16s%2Fg%2F11c0rnlm4y?entry=ttu&g_ep=EgoyMDI2MDgzMC4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver todas las reseñas en Google
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- INFORMACIÓN -->
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Tu experiencia cuenta</p>

          <h2>¿Has estado en Terraza Miami?</h2>

          <p>
            Nos encantará conocer tu opinión. Tu valoración puede ayudar a otras
            personas a descubrir nuestro espacio en Puebla del Prior.
          </p>
        </div>

        <div class="review-cta-card">
          <div>
            <h3>Déjanos tu reseña en Google</h3>

            <p>
              Solo te llevará un momento y es una de las mejores formas de
              apoyar a un pequeño negocio local.
            </p>
          </div>

          <a
            class="button"
            href="https://www.google.es/maps/place/Parque+la+hispanidad/@38.5677406,-6.1930035,715m/data=!3m1!1e3!4m8!3m7!1s0xd14092a6baeba51:0x94ac90d5b47e1f7c!8m2!3d38.5694522!4d-6.1939954!9m1!1b1!16s%2Fg%2F11c0rnlm4y?entry=ttu&g_ep=EgoyMDI2MDgzMC4wIKXMDSoASAFQAw%3D%3D"
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribir una reseña
          </a>
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section class="section section-dark final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>Esperamos verte pronto</h2>

        <p>
          Ven a disfrutar de nuestra terraza, tapas, raciones, comidas, cenas,
          cafés y copas en Puebla del Prior.
        </p>

        <div class="hero-actions">
          <a class="button" href="/contacto">Cómo llegar</a>

          <a
            class="button button-secondary"
            href="https://wa.me/34675326150"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
