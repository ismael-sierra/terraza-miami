---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { negocio } from "../data/negocio";
import { carta, formatearPrecio } from "../data/carta";
---

<BaseLayout
  title="Carta | Terraza Miami"
  description="Consulta la carta de Terraza Miami en Puebla del Prior: pinchitos, montados, raciones, bocadillos, hamburguesas y paninis."
>
  <Header />

  <main>
    <section class="section menu-page">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h1>Nuestra carta</h1>

          <p>
            Descubre nuestra selección de raciones, bocadillos, hamburguesas y
            más.
          </p>
        </div>

        <div class="menu-list">
          {
            carta.map((categoria) => (
              <div class="menu-category">
                <h2>{categoria.titulo}</h2>

                {categoria.descripcion && (
                  <p class="menu-category-description">
                    {categoria.descripcion}
                  </p>
                )}

                {categoria.platos.map((plato) => (
                  <article class="menu-item">
                    <div>
                      <h3>{plato.nombre}</h3>

                      {plato.descripcion && <p>{plato.descripcion}</p>}
                    </div>

                    <p class="menu-price">{formatearPrecio(plato.precio)}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>

        <p class="menu-note">
          Los precios y disponibilidad pueden estar sujetos a cambios. Consulta
          en el establecimiento para confirmar cualquier detalle.
        </p>

        <div class="section-action">
          <a
            class="button"
            href={negocio.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
