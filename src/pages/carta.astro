---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Carta | Terraza Miami"
  description="Consulta la carta de Terraza Miami en Puebla del Prior: montados, rejos, calamares, patatas, queso, jamón, pinchitos, bocadillos y hamburguesas."
>
  <Header />

  <main>
    <section class="section menu-page">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h1>Nuestra carta</h1>

          <p class="intro">
            Tapas, raciones y opciones para disfrutar en nuestra terraza.
          </p>
        </div>

        <div class="menu-list">
          <article class="menu-item">
            <div>
              <h2>Montados de lomo</h2>
            </div>

            <p class="menu-price">2 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Rejos</h2>
            </div>

            <p class="menu-price">10 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Calamares</h2>
            </div>

            <p class="menu-price">10 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Patatas</h2>
            </div>

            <p class="menu-price">5 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Queso</h2>
            </div>

            <p class="menu-price">12 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Jamón</h2>
            </div>

            <p class="menu-price">12 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Pinchitos</h2>
            </div>

            <p class="menu-price">2 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Bocadillos</h2>

              <p>Lomo, bacon o pollo.</p>
            </div>

            <p class="menu-price">5 €</p>
          </article>

          <article class="menu-item">
            <div>
              <h2>Hamburguesas</h2>
            </div>

            <p class="menu-price">4 €</p>
          </article>
        </div>

        <p class="menu-note">Los precios pueden estar sujetos a cambios.</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
