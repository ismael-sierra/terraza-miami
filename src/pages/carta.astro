---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Carta | Terraza Miami"
  description="Consulta la carta de Terraza Miami en Puebla del Prior: pinchitos, montados, raciones, bocadillos, hamburguesas y paninis."
>
  <Header />

  <main>
    <section class="section menu-page">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h1>Nuestra carta</h1>

          <p>
            Descubre nuestra selección de raciones, bocadillos, hamburguesas y
            más.
          </p>
        </div>

        <div class="menu-list">
          <!-- RACIONES Y PARA COMPARTIR -->

          <div class="menu-category">
            <h2>Para compartir</h2>

            <article class="menu-item">
              <div>
                <h3>Pinchitos</h3>
              </div>

              <p class="menu-price">2,50 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Montados de lomo</h3>
              </div>

              <p class="menu-price">2,50 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Ración de rejos</h3>
              </div>

              <p class="menu-price">10,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Ración de calamares</h3>
              </div>

              <p class="menu-price">10,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Ración de patatas</h3>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Plato de jamón</h3>
              </div>

              <p class="menu-price">12,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Plato de queso</h3>
              </div>

              <p class="menu-price">12,00 €</p>
            </article>
          </div>

          <!-- BOCADILLOS -->

          <div class="menu-category">
            <h2>Bocadillos</h2>

            <article class="menu-item">
              <div>
                <h3>Bocadillo de pollo</h3>

                <p>Lechuga, tomate y cebolla.</p>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Bocadillo de lomo</h3>

                <p>Lechuga, tomate y cebolla.</p>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Bocadillo de bacon y queso</h3>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Bocadillo vegetal</h3>

                <p>Lechuga, tomate, atún y cebolla.</p>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>
          </div>

          <!-- HAMBURGUESAS -->

          <div class="menu-category">
            <h2>Hamburguesas</h2>

            <article class="menu-item">
              <div>
                <h3>Hamburguesa simple</h3>

                <p>Lechuga, tomate, cebolla y queso.</p>
              </div>

              <p class="menu-price">4,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Hamburguesa Miami</h3>

                <p>
                  Carne de ternera, lechuga, tomate, cebolla, cebolla crispy,
                  doble queso cheddar y bacon.
                </p>
              </div>

              <p class="menu-price">8,00 €</p>
            </article>
          </div>

          <!-- PANINIS -->

          <div class="menu-category">
            <h2>Paninis</h2>

            <article class="menu-item">
              <div>
                <h3>Panini de atún</h3>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Panini de jamón York y queso</h3>
              </div>

              <p class="menu-price">5,00 €</p>
            </article>
          </div>

          <!-- EXTRAS -->

          <div class="menu-category">
            <h2>Ingredientes extra</h2>

            <p class="menu-category-description">
              Para bocadillos y hamburguesas.
            </p>

            <article class="menu-item">
              <div>
                <h3>Bacon</h3>
              </div>

              <p class="menu-price">0,50 €</p>
            </article>

            <article class="menu-item">
              <div>
                <h3>Queso</h3>
              </div>

              <p class="menu-price">0,50 €</p>
            </article>
          </div>
        </div>

        <p class="menu-note">
          Los precios y disponibilidad pueden estar sujetos a cambios. Consulta
          en el establecimiento para confirmar cualquier detalle.
        </p>

        <div class="section-action">
          <a
            class="button"
            href="https://wa.me/34675326150"
            target="_blank"
            rel="noopener noreferrer"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
