---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OpeningHours from "../components/OpeningHours.astro";
import { negocio } from "../data/negocio";
---

<BaseLayout
  title="Contacto y ubicación | Terraza Miami"
  description="Encuentra Terraza Miami en Puebla del Prior, Badajoz. Consulta nuestra dirección, horario y formas de contacto."
>
  <Header />

  <main>
    <section class="section contact-page">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Terraza Miami</p>

          <h1>Ven a visitarnos</h1>

          <p>
            Estamos en Puebla del Prior, Badajoz. Aquí tienes toda la
            información para encontrarnos y ponerte en contacto con nosotros.
          </p>
        </div>

        <div class="contact-grid">
          <!-- UBICACIÓN -->

          <article class="contact-card">
            <h2>Dirección</h2>

            <address>
              {negocio.direccion.calle}<br />
              {negocio.direccion.codigoPostal}
              {negocio.direccion.localidad}<br />
              {negocio.direccion.provincia}
            </address>

            <a
              class="button"
              href={negocio.mapas.comoLlegar}
              target="_blank"
              rel="noopener noreferrer"
            >
              Cómo llegar
            </a>
          </article>

          <!-- CONTACTO -->

          <article class="contact-card">
            <h2>Contacto</h2>

            <p>
              <strong>Teléfono</strong><br />

              <a href={negocio.telefono.enlace}>{negocio.telefono.visible}</a>
            </p>

            <p>También puedes escribirnos directamente por WhatsApp.</p>

            <a
              class="button"
              href={negocio.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
            >
              Escribir por WhatsApp
            </a>
          </article>

          <!-- HORARIO -->

          <article class="contact-card">
            <h2>Horario</h2>

            <OpeningHours formato="linea" />
          </article>
        </div>

        <!-- MAPA -->

        <div class="map-section">
          <div class="section-heading">
            <p class="eyebrow">Ubicación</p>

            <h2>¿Dónde estamos?</h2>
          </div>

          <div class="map-container">
            <iframe
              src={negocio.mapas.embed}
              title="Mapa de la ubicación de Terraza Miami"
              width="600"
              height="450"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->

    <section class="section section-dark final-cta">
      <div class="container">
        <p class="eyebrow">Terraza Miami</p>

        <h2>Te esperamos</h2>

        <p>
          Si tienes alguna duda, puedes llamarnos o escribirnos por WhatsApp.
        </p>

        <div class="hero-actions">
          <a class="button" href={negocio.telefono.enlace}> Llamar </a>

          <a
            class="button button-secondary"
            href={negocio.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
