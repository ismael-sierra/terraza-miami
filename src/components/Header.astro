---
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/carta", texto: "Carta" },
  { href: "/nosotros", texto: "Nosotros" },
  { href: "/resenas", texto: "Reseñas" },
  { href: "/noticias", texto: "Noticias" },
  { href: "/contacto", texto: "Contacto" },
];

const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/";

// "page" en la página exacta; "true" en las subpáginas (por ejemplo, una noticia).
function estadoEnlace(href: string) {
  if (rutaActual === href) return "page";
  if (href !== "/" && rutaActual.startsWith(`${href}/`)) return "true";
  return undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Terraza Miami - Inicio">
      <img src="/images/logo.jpg" alt="Terraza Miami" />
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span class="sr-only">Abrir menú</span>

      <span aria-hidden="true"> ☰ </span>
    </button>

    <nav
      id="main-navigation"
      class="main-navigation"
      aria-label="Navegación principal"
    >
      {
        enlaces.map(({ href, texto }) => (
          <a href={href} aria-current={estadoEnlace(href)}>
            {texto}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");

  const navigation = document.querySelector<HTMLElement>("#main-navigation");

  if (menuButton && navigation) {
    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";

      menuButton.setAttribute("aria-expanded", String(!isOpen));

      navigation.classList.toggle("is-open", !isOpen);
    });
  }
</script>
