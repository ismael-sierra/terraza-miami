---
import { negocio } from "../data/negocio";

const { direccion, horarioResumen, redes } = negocio;
const anioActual = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Terraza Miami - Inicio">
        <img src="/images/logo.jpg" alt="Terraza Miami" />
      </a>

      <p>Terraza, tapas, raciones y buenos momentos en Puebla del Prior.</p>
    </div>

    <div>
      <h2>Contacto</h2>

      <p>
        <a href={negocio.telefono.enlace}>{negocio.telefono.visible}</a>
      </p>

      <p>
        {direccion.calle}<br />
        {direccion.codigoPostal}
        {direccion.localidad}, {direccion.provincia}
      </p>
    </div>

    <div>
      <h2>Horario</h2>

      <p>
        {horarioResumen.lineas.map((linea, i) => (i > 0 ? [<br />, linea] : linea))}
      </p>

      <p>
        <strong>{horarioResumen.cerrado}</strong>
      </p>
    </div>

    <div>
      <h2>Información</h2>

      <nav aria-label="Información legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Política de privacidad</a>
        <a href="/cookies">Política de cookies</a>
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {anioActual} Terraza Miami. Todos los derechos reservados.</p>

    <div class="footer-social">
      <a
        href={redes.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook de Terraza Miami"
      >
        Facebook
      </a>

      <span aria-hidden="true">·</span>

      <a
        href={redes.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Terraza Miami"
      >
        Instagram
      </a>
    </div>
  </div>
  <div class="footer-credit">
    <p>Web creada por Ismael Sierra Vega</p>
  </div>
</footer>
