---
interface Props {
  imagenes: { src: string; alt: string }[];
}

const { imagenes } = Astro.props;
---

<div class="gallery">
  {
    imagenes.map(({ src, alt }) => (
      <button
        class="gallery-item"
        type="button"
        aria-label={`Ampliar imagen: ${alt}`}
        data-lightbox={src}
      >
        <img src={src} alt={alt} loading="lazy" />
      </button>
    ))
  }
</div>

